# A 股投研助手配置
# 复制此文件为 .env 并填入真实值

# === LLM（Anthropic）===
# pydantic 自动将 anthropic_api_key 映射为环境变量 ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# 可选：用于在回答末尾估算 LLM cost。单位：每 100 万 tokens。
# 不配置或填 0 时，页面会显示 token 统计和“未配置单价”。
LLM_INPUT_COST_PER_1M_TOKENS=0
LLM_OUTPUT_COST_PER_1M_TOKENS=0
LLM_COST_CURRENCY=USD

# === 数据源 ===
TUSHARE_TOKEN=

# === 功能开关 ===
USE_AKSHARE_HOTLIST=true
USE_CNINFO_PROVIDER=true

# === 存储路径 ===
TRACE_STORE_PATH=.local/trace.jsonl
USER_MEMORY_PATH=.local/user_memory.json

# === 运行环境 ===
APP_ENV=development
LOG_LEVEL=INFO
